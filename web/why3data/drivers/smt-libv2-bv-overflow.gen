

theory bv.BV_Gen

  syntax predicate u_add_o "(bvuaddo %1 %2)"
  syntax predicate s_add_o "(bvsaddo %1 %2)"
  syntax predicate u_sub_o "(bvusubo %1 %2)"
  syntax predicate s_sub_o "(bvssubo %1 %2)"
  syntax predicate u_mul_o "(bvumulo %1 %2)"
  syntax predicate s_mul_o "(bvsmulo %1 %2)"
  syntax predicate s_div_o "(bvsdivo %1 %2)"

end
