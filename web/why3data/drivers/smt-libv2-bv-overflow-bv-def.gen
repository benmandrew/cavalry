

theory bv.BV_Gen


  syntax predicate u_add_o "(u_add_o_bv_def %1 %2)"
  syntax predicate s_add_o "(s_add_o_bv_def %1 %2)"
  syntax predicate u_sub_o "(u_sub_o_bv_def %1 %2)"
  syntax predicate s_sub_o "(s_sub_o_bv_def %1 %2)"
  syntax predicate u_mul_o "(u_mul_o_bv_def %1 %2)"
  syntax predicate s_mul_o "(s_mul_o_bv_def %1 %2)"
  syntax predicate s_div_o "(s_div_o_bv_def %1 %2)"

end
